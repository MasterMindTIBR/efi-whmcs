{
    "name": "mastermind/whmcs-efi-gateway-core",
    "description": "Biblioteca compartilhada pelos módulos de gateway Efí para WHMCS (efi_boleto, efi_pix, efi_cartao).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "efipay/sdk-php-apis-efi": "^1.19",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "EfiWhmcs\\": "lib/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
