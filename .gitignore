# Notas internas de arquitetura -- não publicadas no repositório.

# Análises internas e ferramentas operacionais específicas do ambiente (receiver de deploy,
# segredos locais) -- nunca publicadas no repositório público.
/.local/
/ARQUITETURA.md

# SO / editor
.DS_Store
Thumbs.db
*.swp

# vendor/ é commitado propositalmente (facilita instalação sem Composer no servidor).

# Dependências e cache da suíte dev-only; nunca entram no pacote de release.
/tests/vendor/
/tests/.phpunit.result.cache

# Cache de token do SDK da Efí (arquivos gerados em runtime; ver EfiClientFactory::redirectSdkCache).
/modules/gateways/efi/storage/sdk-cache/*
!/modules/gateways/efi/storage/sdk-cache/.gitkeep
